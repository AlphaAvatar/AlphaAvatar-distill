{
 "spec": "aadistill.artifact_spec/v1",
 "session": "autoinit_d2_confirmation",
 "note": "failure spec: the same classes, none required -- a session that stopped early collects whatever exists, and the launcher's poll hook has already secured every scored probe and every trained checkpoint off-pod.",
 "patterns_are_relative_to": "the collector's --root, which SessionRunner sets to <checkout>/artifacts. So `audit/autoinit_d2_confirmation/x` is <checkout>/artifacts/audit/autoinit_d2_confirmation/x.",
 "one_authoritative_layout": "artifacts/audit/autoinit_d2_confirmation/ is where the driver writes and where the relay, the report fetch, the launcher's poll hook (D1's durability functions under D2's layout) and this spec all read.",
 "entries": [
  {
   "artifact_class": "d2_confirmation_record",
   "pattern": "audit/autoinit_d2_confirmation/d2_confirmation.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_results",
   "pattern": "audit/autoinit_d2_confirmation/results/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_per_sample",
   "pattern": "audit/autoinit_d2_confirmation/per_sample/*.jsonl",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_generations",
   "pattern": "audit/autoinit_d2_confirmation/generations/*/*",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_probe_configs",
   "pattern": "audit/autoinit_d2_confirmation/configs/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_attested_protocol",
   "pattern": "audit/autoinit_d2_confirmation/d2_confirmation_attested_protocol.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_engine_probe",
   "pattern": "audit/autoinit_d2_confirmation/engine_probe.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_generation_admissions",
   "pattern": "audit/autoinit_d2_confirmation/*_generation_admission.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_rescoring",
   "pattern": "audit/autoinit_d2_confirmation/rescoring/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_tails",
   "pattern": "audit/autoinit_d2_confirmation/*_tail.log",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d2_confirmation_release_acks",
   "pattern": "audit/autoinit_d2_confirmation/release_acks/*.json",
   "required": false,
   "lifecycle": "final_required"
  }
 ]
}

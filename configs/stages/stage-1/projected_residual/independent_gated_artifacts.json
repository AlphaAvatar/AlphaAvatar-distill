  {"artifact_class": "validation_evidence", "pattern": "audit/stage1_independent_gated_engineering/*/*.json", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "validation_logs", "pattern": "audit/stage1_independent_gated_engineering/*/*.log", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "session_logs", "pattern": "audit/stage1_independent_gated_engineering/session/*", "required": false, "lifecycle": "final_required", "min_matches": 0}

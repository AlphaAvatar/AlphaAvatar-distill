{
 "spec": "aadistill.artifact_spec/v1",
 "session": "autoinit_d3_probes",
 "note": "failure spec: the same classes, none required -- a session that stopped early collects whatever exists, and the launcher's poll hook has already secured every scored probe and every trained checkpoint off-pod.",
 "patterns_are_relative_to": "the collector's --root, which SessionRunner sets to <checkout>/artifacts. So `audit/autoinit_d3_probes/x` is <checkout>/artifacts/audit/autoinit_d3_probes/x.",
 "one_authoritative_layout": "artifacts/audit/autoinit_d3_probes/ is where the driver writes and where the relay, the report fetch, the launcher's poll hook (D1's durability functions under D3's probes layout) and this spec all read.",
 "entries": [
  {
   "artifact_class": "d3_probes_record",
   "pattern": "audit/autoinit_d3_probes/d3_probes.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_results",
   "pattern": "audit/autoinit_d3_probes/results/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_per_sample",
   "pattern": "audit/autoinit_d3_probes/per_sample/*.jsonl",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_generations",
   "pattern": "audit/autoinit_d3_probes/generations/*/*",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_probe_configs",
   "pattern": "audit/autoinit_d3_probes/configs/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_attested_protocol",
   "pattern": "audit/autoinit_d3_probes/d3_probes_attested_protocol.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_engine_probe",
   "pattern": "audit/autoinit_d3_probes/engine_probe.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_generation_admissions",
   "pattern": "audit/autoinit_d3_probes/*_generation_admission.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_rescoring",
   "pattern": "audit/autoinit_d3_probes/rescoring/*.json",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_tails",
   "pattern": "audit/autoinit_d3_probes/*_tail.log",
   "required": false,
   "lifecycle": "final_required"
  },
  {
   "artifact_class": "d3_probes_release_acks",
   "pattern": "audit/autoinit_d3_probes/release_acks/*.json",
   "required": false,
   "lifecycle": "final_required"
  }
 ]
}

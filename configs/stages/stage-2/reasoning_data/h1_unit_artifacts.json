{
 "spec": "aadistill.artifact_spec/v1",
 "session": "stage2_h1_units",
 "note": "One spec for success and failure; every entry has at least zero matches, because an early failure legitimately produced none (P8.2.1: preserved when they exist, never demanded). The units' checkpoints, save points and evaluations are on the network volume as each completes; each finished unit's evidence (never weights) is also tarred, pulled by the launcher's poll hook and hash-checked before this archive exists.",
 "patterns_are_relative_to": "the collector's --root, <checkout>/artifacts",
 "entries": [
  {"artifact_class": "unit_evidence", "pattern": "audit/stage2_h1_units/*.evidence.tgz", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "driver_status", "pattern": "audit/stage2_h1_units/driver_status.json", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "session_logs", "pattern": "audit/stage2_h1_units/session/*", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "p1g_report", "pattern": "stages/stage-2/reasoning_data/units/*/p1g/p1g_report.json", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "p1g_logs", "pattern": "stages/stage-2/reasoning_data/units/*/p1g/*.log", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "p1g_trainer_logs", "pattern": "stages/stage-2/reasoning_data/units/*/p1g/*/train_log.jsonl", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "p1g_configs", "pattern": "stages/stage-2/reasoning_data/units/*/p1g/*.json", "required": false, "lifecycle": "final_required", "min_matches": 0},
  {"artifact_class": "unit_attempt_logs", "pattern": "stages/stage-2/reasoning_data/units/*/*/attempt-*/*.log", "required": false, "lifecycle": "final_required", "min_matches": 0}
 ],
 "authorizes": "nothing"
}

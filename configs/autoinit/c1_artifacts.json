      "pattern": "stage3/phase_a/autoinit.v1.phase_c1.*/train_log.jsonl",
      "required": true,
      "lifecycle": "final_required",
      "min_matches": 6,
      "min_bytes": 1
    },
    {
      "artifact_class": "probe_run_manifest",
      "pattern": "stage3/phase_a/autoinit.v1.phase_c1.*/run_manifest*.json",

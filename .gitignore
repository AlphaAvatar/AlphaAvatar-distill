# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.python-version.local

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Secrets and local env
.env
.env.*
*.key
*.pem

# Downloaded third-party warm-up text (rebuild with scripts/build_warmup_v1.py;
# the committed .manifest.json pins revisions and hashes)
data/warmup/warmup_v1.jsonl
data/warmup/holdout_v1.jsonl

# Stage 2 offline mixture (rebuild with scripts/build_stage2_v0.py /
# build_stage2_v1.py; committed manifests pin revisions and hashes)
data/stage2/train/
data/stage2/val/
data/stage2/calib/
data/stage2_v1/train/
data/stage2_v1/val/
data/stage2_v1/calib/

# Stage 3 teacher-target 2x2 arms (rebuild with scripts/data/build_stage3_pilot.py
# from the hashed generation corpus; the committed manifest.json pins both arms'
# per-file hashes, counts and packing)
data/stage3_pilot/*/train/
data/stage3_pilot/*/val/

# Heavy local artifacts (activation caches, checkpoints, datasets, run outputs)
artifacts/
checkpoints/
# Anchored, for the same reason `runs/` needed the exception below: unanchored,
# it matched `configs/datasets/` and silently refused to track the dataset-asset
# DECLARATIONS -- a small reviewable JSON that the pod must be able to read. The
# file was written, never committed, and the pod simulation then hid it and
# failed every test at conftest import. Heavy datasets live at the repo root.
/datasets/
wandb/
runs/

# ...but `logs/runs/` is the run-layout-v2 EVIDENCE root, not a training output.
# The bare `runs/` above matches a directory of that name at any depth, so it
# silently swallowed the run index and would have swallowed every future run
# manifest — evidence written and never tracked, which is the one failure mode a
# provenance layout must not have. Reviewable records only: manifests, governance
# and closeout JSON and the status stream. Anything heavy under a run is still
# excluded by the patterns below (*.safetensors, *.pt, …) and by the explicit
# training/evaluation exclusions here.
!logs/runs/
!logs/runs/**/
logs/runs/**/evidence/training/
logs/runs/**/evidence/evaluation/
!logs/runs/**/*.json
!logs/runs/**/*.jsonl

# ...and the SAME policy for the canonical stage-first evidence root. A run
# lives at `logs/stages/<stage>/<experiment>/runs/<run>/` now, and only the old
# `logs/runs/` root was exempted above -- so every run directory created after
# that migration was silently ignored. `runs/attempt13/governance/readiness.json`
# was written by a launch-bound sweep and never tracked, while attempt 12's
# equivalent IS tracked because it predates the move. That made the launch chain
# unsatisfiable: the one path the session-lineage rule permits to differ after a
# sweep was a path git could not see, so the sweep's own tracked output looked
# like undeclared drift.
#
# Written generically. No stage number, experiment id or attempt id appears
# here: a Stage-4 rollout run gets this the day it is created.
!logs/stages/**/runs/
!logs/stages/**/runs/**/
logs/stages/**/runs/**/evidence/training/
logs/stages/**/runs/**/evidence/evaluation/
!logs/stages/**/runs/**/*.json
!logs/stages/**/runs/**/*.jsonl

# Archives anywhere in the tree. A session's collected-artifact tarball is the
# one heavy thing a run legitimately produces beside its manifest, and it is
# exactly the shape the exclusions below do not catch: `logs/runs/**/*.gz` was
# TRACKED, because the `runs/` rule matches directories and nothing here matched
# the file. The tarball belongs in the scratch directory with the extracted tree;
# the run manifest carries its hash. No archive is currently tracked, so this
# removes nothing.
*.tar
*.tar.gz
*.tgz
*.zip

# Model weights anywhere in the tree (small metadata/manifests stay tracked)
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Hugging Face / torch caches if ever redirected into the repo
hf_cache/
torch_cache/

# Audit artifacts (complete generations preserved locally / on the relay)
artifacts/audit/

# Git bundles used to ship the session to a pod; built in scratch, never here.
*.bundle
